{
  "type": "record",
  "name": "EventMeta",
  "namespace": "me.oneorg.melody.events",
  "doc": "Embedded in every event. Consumers drop duplicates by event_id.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "UUID v7; made by the client for telemetry, by the server for state changes."},
    {"name": "occurred_at", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When it happened on the device or server."},
    {"name": "received_at", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the core API accepted it."},
    {"name": "source", "type": "string", "doc": "Who produced it, e.g. app, web, core-api, admin-api."}
  ]
}
