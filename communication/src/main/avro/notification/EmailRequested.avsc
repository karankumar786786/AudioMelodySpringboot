{
  "type": "record", "name": "EmailRequested", "namespace": "me.oneorg.melody.events",
  "doc": "One email to send. Topics notification.email.v1 and notification.email.retry.v1, key = SHA-256 of the address. May carry a one-time code: 1-day retention, restricted readers, never logged.",
  "fields": [
    {"name": "meta", "type": "EventMeta"},
    {"name": "to", "type": "string"},
    {"name": "kind", "type": "string", "doc": "REGISTER, LOGIN, ADMIN_LOGIN, NEW_RELEASE, ..."},
    {"name": "subject", "type": "string"},
    {"name": "body", "type": "string"},
    {"name": "attempt", "type": "int", "default": 0},
    {"name": "not_before", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null}
  ]
}
