{
  "type" : "record",
  "name" : "SongStats",
  "namespace" : "me.oneorg.melody.events.stats",
  "doc" : "Running totals per song. Topic stats.song.v1 (compacted), key song_id.",
  "fields" : [ {
    "name" : "song_id",
    "type" : {
      "type" : "string",
      "avro.java.string" : "String"
    }
  }, {
    "name" : "plays",
    "type" : "long",
    "default" : 0
  }, {
    "name" : "qualified_streams",
    "type" : "long",
    "default" : 0
  }, {
    "name" : "listened_ratio_sum",
    "type" : "double",
    "default" : 0
  }, {
    "name" : "skips",
    "type" : "long",
    "default" : 0
  }, {
    "name" : "favourites",
    "type" : "long",
    "default" : 0
  }, {
    "name" : "updated_at",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-millis"
    }
  } ]
}
