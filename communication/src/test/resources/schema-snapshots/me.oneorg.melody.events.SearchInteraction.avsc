{
  "type" : "record",
  "name" : "SearchInteraction",
  "namespace" : "me.oneorg.melody.events",
  "doc" : "A search result was played or clicked. Topic search.interaction.v1, key user_id (or 'anonymous').",
  "fields" : [ {
    "name" : "meta",
    "type" : {
      "type" : "record",
      "name" : "EventMeta",
      "doc" : "Embedded in every event. Consumers drop duplicates by event_id.",
      "fields" : [ {
        "name" : "event_id",
        "type" : {
          "type" : "string",
          "avro.java.string" : "String"
        },
        "doc" : "UUID v7; made by the client for telemetry, by the server for state changes."
      }, {
        "name" : "occurred_at",
        "type" : {
          "type" : "long",
          "logicalType" : "timestamp-millis"
        },
        "doc" : "When it happened on the device or server."
      }, {
        "name" : "received_at",
        "type" : {
          "type" : "long",
          "logicalType" : "timestamp-millis"
        },
        "doc" : "When the core API accepted it."
      }, {
        "name" : "source",
        "type" : {
          "type" : "string",
          "avro.java.string" : "String"
        },
        "doc" : "Who produced it, e.g. app, web, core-api, admin-api."
      } ]
    }
  }, {
    "name" : "user_id",
    "type" : [ "null", {
      "type" : "string",
      "avro.java.string" : "String"
    } ],
    "default" : null
  }, {
    "name" : "action",
    "type" : {
      "type" : "enum",
      "name" : "SearchAction",
      "symbols" : [ "PLAY", "CLICK" ]
    }
  }, {
    "name" : "entity_type",
    "type" : {
      "type" : "string",
      "avro.java.string" : "String"
    },
    "doc" : "SONG, ARTIST, PLAYLIST, ..."
  }, {
    "name" : "entity_id",
    "type" : {
      "type" : "string",
      "avro.java.string" : "String"
    }
  } ]
}
