JOB_PROCESSING_QUEUE=audio_processing_queue
DELETE_EVENT_QUEUE=delete_event_queue
CANCEL_EVENT_QUEUE=audio_cancel_queue
QUEUE_EMPTY_DELAY_MS=2000
QUEUE_POLL_TIMEOUT_SECS=2
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_SSL_ENABLED=true

# Application Webhook URL
APPLICATION_URL=https://api.your-domain.com/webhook/job
APPLICATION_API_KEY=your_application_api_key

# AWS S3 Config
REGION=ap-south-1
ACCESS_KEY_ID=your_aws_access_key_id
SECRET_KEY=your_aws_secret_key
TEMP_BUCKET_NAME=your_temp_bucket
PRODUCTION_BUCKET_NAME=your_production_bucket
BASE_PATH=audios
VIDEO_BASE_PATH=videos

# ImageKit Config
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Inngest Cloud
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
# Inngest dev mode (set to 1 when testing with local Inngest Dev Server)
INNGEST_DEV=0
