{
  "name": "audioapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.22",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.5",
    "algoliasearch": "^5.60.0",
    "axios": "^1.20.0",
    "expo": "~58.0.17",
    "expo-audio": "58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-crypto": "^58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "^58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-screen-orientation": "^58.0.3",
    "expo-secure-store": "^58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "58.0.12",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|immer))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
