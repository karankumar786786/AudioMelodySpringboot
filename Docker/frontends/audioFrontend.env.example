# ==============================================================================
# One Melody - Audio Frontend Environment Configuration (.env.example)
# Service: Next.js Client Web Player (Port 3000)
# ==============================================================================

# Core Spring Boot API Base URL
NEXT_PUBLIC_API_URL=https://api.your-domain.com
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:9090

# S3 / CloudFront Storage Base URL for Audio Streaming & Packaged Manifests
NEXT_PUBLIC_S3_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com
# Or CloudFront CDN:
# NEXT_PUBLIC_S3_BASE_URL=https://your-distribution-id.cloudfront.net

# Algolia Instant Search Credentials (Client-Safe Search-Only Key)
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_only_key
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=one_melody_springboot

# Recombee AI Recommendations (Client-Safe Public Token)
NEXT_PUBLIC_RECOMBEE_DATABASE_ID=your_recombee_db_id
NEXT_PUBLIC_RECOMBEE_PUBLIC_TOKEN=your_recombee_public_token
NEXT_PUBLIC_RECOMBEE_REGION=eu-west
