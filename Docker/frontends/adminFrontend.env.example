# ==============================================================================
# One Melody - Admin Frontend Environment Configuration (.env.example)
# Service: Next.js Admin Dashboard (Port 3000)
# ==============================================================================

# Admin Django Backend API Base URL
NEXT_PUBLIC_API_URL=https://api-admin.your-domain.com
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ImageKit CDN Public Key (for media assets & uploads)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key_here

# Runtime Settings
NODE_ENV=production
PORT=3000
