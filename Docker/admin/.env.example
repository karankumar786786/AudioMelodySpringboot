APPLICATION_NAME=one_melody
APPLICATION_API_KEY=your_application_api_key
ADMIN_ID=admin1
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
PORT=8000

# Database (Neon / PostgreSQL)
DB_URL=jdbc:postgresql://your-db-host/one-melody-spring?sslmode=require&channelBinding=require
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Redis / Upstash
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_SSL_ENABLED=true
REDIS_MAIL_QUEUE=mail_queue
REDIS_AUDIO_PROCESSING_QUEUE=audio_processing_queue
REDIS_DELETE_QUEUE=delete_event_queue
REDIS_CANCEL_QUEUE=audio_cancel_queue

# Algolia Search
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_INDEX_NAME=one_melody_springboot

# Recombee Recommendation
RECOMBEE_DATABASE_ID=your_recombee_database_id
RECOMBEE_DATABASE_SECRET=your_recombee_database_secret
RECOMBEE_DATABASE_REGION=EU_WEST

# SMTP / Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="One Melody Springboot"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM="One Melody Springboot"

# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Security
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_bytes_long

# Audio Processing Worker
AUDIO_PROCESSING_API_KEY=your_application_api_key
AUDIO_PROCESSING_URL=http://process:5010

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_ENDPOINT=
S3_TEMP_BUCKET=audiomelody-temp-storage-alive-oneorg
S3_PRODUCTION_BUCKET=audiomelody-prod-storage-alive-oneorg

# Inngest Server
INNGEST_DEV_URL=http://localhost:8288
