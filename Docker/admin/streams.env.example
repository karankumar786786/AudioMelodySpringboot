# ==============================================================================
# One Melody - Stream services (streams/) Environment Configuration (.env.example)
# Runs on the processing server next to Redpanda. KAFKA_BOOTSTRAP_SERVERS and
# SCHEMA_REGISTRY_URL are set in docker-compose.yml (redpanda:29092 / :8081).
# ==============================================================================

# Which services this container runs (comma separated):
#   outbox-relay, stats, activity, sync, notification
STREAMS_PROFILES=outbox-relay,stats,activity,sync,notification,analytics

# Postgres (Neon) - same database as the core and admin APIs
DB_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Cut-over switches. Leave false while the core API runs EVENTS_MODE=LEGACY or DUAL
# (the core API still writes history and calls Recombee/Algolia itself). Set both to
# true in the same deploy that sets the core API to EVENTS_MODE=KAFKA.
STREAMS_HISTORY_SINK_ENABLED=false
STREAMS_SYNC_ENABLED=false
# Email followers when an artist publishes a song.
STREAMS_NEW_RELEASE_EMAILS_ENABLED=false

# How often the outbox relay sweeps for rows whose wake-up was lost (ISO-8601).
OUTBOX_SAFETY_SWEEP=PT6H

# --- syncStreams: Recombee + Algolia (same values as the core API) ---
RECOMBEE_DATABASE_ID=your_recombee_db
RECOMBEE_DATABASE_SECRET=your_recombee_private_token
RECOMBEE_DATABASE_REGION=EU_WEST
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_admin_api_key
ALGOLIA_INDEX_NAME=your_index

# --- notificationStreams: same provider settings as the Bun mail worker ---
# smtp (Gmail) | ses | resend | log (local dev: logs instead of sending)
MAIL_PROVIDER=smtp
# MAIL_FROM="One Melody" <noreply@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="One Melody Springboot"
# AWS_REGION=ap-south-1          # ses (instance role or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# RESEND_API_KEY=re_your_key     # resend

# OpenTelemetry (the java agent reads these)
OTEL_SERVICE_NAME=melody-streams
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
