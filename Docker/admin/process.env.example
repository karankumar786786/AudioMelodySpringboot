# ==============================================================================
# One Melody - Audio Processing Worker Environment Configuration (.env.example)
# Service: Bun FFmpeg & Shaka Transcoding Pipeline (Port 5010)
# ==============================================================================

# Redis Message Queues
JOB_PROCESSING_QUEUE=audio_processing_queue
DELETE_EVENT_QUEUE=delete_event_queue
CANCEL_EVENT_QUEUE=audio_cancel_queue
QUEUE_EMPTY_DELAY_MS=2000
QUEUE_POLL_TIMEOUT_SECS=2

# Redis Connection (Upstash / Redis 7)
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL_ENABLED=true

# Application Webhook & Bidirectional Telemetry URLs (Points to Admin Backend container)
APPLICATION_URL=http://admin:8000/webhook/job
APPLICATION_DELETE_URL=http://admin:8000/webhook/delete
APPLICATION_API_KEY=your_secure_application_api_key_here
AUDIO_PROCESSING_API_KEY=your_secure_application_api_key_here

# AWS S3 Cloud Storage
REGION=ap-south-1
ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
SECRET_KEY=your_aws_secret_access_key
TEMP_BUCKET_NAME=audiomelody-temp-storage-oneorg
PRODUCTION_BUCKET_NAME=audiomelody-prod-storage-oneorg
BASE_PATH=audios
VIDEO_BASE_PATH=videos

# ImageKit Configuration (for artwork CDN cleanup)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Inngest Cloud Orchestration
INNGEST_DEV=0
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key_here

# Transcoding Concurrency Limit (CPU core throttler)
CONCURRENT_TRANSCODING_LIMIT=2

# Algolia Configuration (for real-time index sync & deletion)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_admin_api_key
ALGOLIA_INDEX_NAME=one_melody_springboot
