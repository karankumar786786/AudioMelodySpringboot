# ==============================================================================
# One Melody - Admin Backend Environment Configuration (.env.example)
# Service: Django Gunicorn API (Port 8000)
# ==============================================================================

# Application Metadata & Security
APPLICATION_NAME=one_melody
APPLICATION_API_KEY=your_secure_application_api_key_here
PORT=8000
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_bytes_long_and_very_secure

# Super Admin Account Bootstrap
ADMIN_ID=admin1
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@your-domain.com

# PostgreSQL Database (Neon Serverless / RDS)
# Note: Supports jdbc:postgresql:// or postgresql:// formats
DB_URL=postgresql://neondb_owner:password@ep-xyz-pooler.region.aws.neon.tech/melody?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_db_password_here

# Redis Cache & Message Queues (Upstash / Redis 7)
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL_ENABLED=true
REDIS_MAIL_QUEUE=mail_queue
REDIS_AUDIO_PROCESSING_QUEUE=audio_processing_queue
REDIS_DELETE_QUEUE=delete_event_queue
REDIS_CANCEL_QUEUE=audio_cancel_queue

# Search Indexing (Algolia)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_admin_api_key
ALGOLIA_INDEX_NAME=one_melody_springboot

# Recommendation Engine (Recombee)
RECOMBEE_DATABASE_ID=your_recombee_db_id
RECOMBEE_DATABASE_SECRET=your_recombee_private_token
RECOMBEE_DATABASE_REGION=EU_WEST

# Email & OTP Dispatch (SMTP / Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="One Melody Admin"

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_16_digit_app_password
MAIL_FROM="One Melody Admin"

# Image Storage & Optimization (ImageKit)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Cloudinary Managed Media Infrastructure
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Audio Processing Worker Node Inter-Service Communication
AUDIO_PROCESSING_URL=http://process:5010
AUDIO_PROCESSING_API_KEY=your_secure_application_api_key_here

# AWS S3 Storage
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_ENDPOINT=
S3_TEMP_BUCKET=audiomelody-temp-storage-oneorg
S3_PRODUCTION_BUCKET=audiomelody-prod-storage-oneorg

# Inngest Serverless Workflow Orchestration
INNGEST_DEV=0
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key_here
INNGEST_DEV_URL=http://localhost:8288
