# ==============================================================================
# One Melody - Core Engine Environment Configuration (.env.example)
# Service: Java Spring Boot API (Port 9090)
# ==============================================================================

# Application Metadata & Security
APPLICATION_NAME=one_melody
APPLICATION_API_KEY=your_secure_application_api_key_here
PORT=9090
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_bytes_long_and_very_secure

# Super Admin Account Bootstrap
ADMIN_ID=admin1
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@your-domain.com

# PostgreSQL Database (Neon Serverless / RDS)
# Note: Format must start with jdbc:postgresql://
DB_URL=jdbc:postgresql://ep-xyz-pooler.region.aws.neon.tech/melody?sslmode=require&channelBinding=require
DB_USER=neondb_owner
DB_PASSWORD=your_db_password_here

# Redis Cache & Message Queues (Upstash / Redis 7)
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL_ENABLED=true
REDIS_MAIL_QUEUE=mail_queue
REDIS_AUDIO_PROCESSING_QUEUE=audio_processing_queue

# Search Indexing (Algolia)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_admin_api_key
ALGOLIA_INDEX_NAME=one_melody_springboot
ALGOLIA_SEARCH_API_KEY=your_algolia_search_only_api_key

# Recommendation Engine (Recombee)
RECOMBEE_DATABASE_ID=your_recombee_db_id
RECOMBEE_DATABASE_SECRET=your_recombee_private_token
RECOMBEE_DATABASE_REGION=EU_WEST

# Email & OTP Dispatch (SMTP / Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="One Melody Springboot"

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_16_digit_app_password
MAIL_FROM="One Melody Springboot"

# Image Storage & CDN (ImageKit)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Audio Processing Worker Node Inter-Service Communication
AUDIO_PROCESSING_API_KEY=your_secure_application_api_key_here
AUDIO_PROCESSING_URL=https://audio-processing.one-org.me

# AWS S3 Cloud Storage
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_ENDPOINT=
S3_TEMP_BUCKET=audiomelody-temp-storage-oneorg
S3_PRODUCTION_BUCKET=audiomelody-prod-storage-oneorg

# OpenTelemetry Tracing, Metrics, and Logs (Uptrace / OTel Collector)
OTEL_SERVICE_NAME=core-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp

# Cookie Security
COOKIE_DOMAIN=.one-org.me
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
COOKIE_ACCESS_MAX_AGE=300
COOKIE_REFRESH_MAX_AGE=604800

# CORS
CORS_ALLOWED_ORIGINS=https://one-melody.one-org.me,https://www.one-melody.one-org.me,https://*.one-org.me,http://localhost:3000,http://localhost:5173
