# ==============================================================================
# Watchtower Continuous Deployment Configuration (.env.example)
# Service: containrrr/watchtower (Core Engine Stack)
# ==============================================================================

# Docker API version negotiation (required for modern Docker daemons on Ubuntu 24.04+)
DOCKER_API_VERSION=1.44

# Poll interval in seconds (check for new image digests every 30 seconds)
WATCHTOWER_POLL_INTERVAL=30

# Automatically remove old, superseded Docker images to prevent disk exhaustion
WATCHTOWER_CLEANUP=true

# Restart updated containers one at a time to minimize service disruption
WATCHTOWER_ROLLING_RESTART=true

# Include restarting containers
WATCHTOWER_INCLUDE_RESTARTING=true

# Ignore stopped containers
WATCHTOWER_INCLUDE_STOPPED=false

# Logging verbosity (options: panic, fatal, error, warn, info, debug, trace)
WATCHTOWER_LOG_LEVEL=info

# Monitor only containers with com.centurylinklabs.watchtower.enable=true label
WATCHTOWER_LABEL_ENABLE=true

# Docker Hub authentication (uncomment if using private images or high pull rates)
# REPO_USER=your_dockerhub_username
# REPO_PASS=your_dockerhub_personal_access_token
