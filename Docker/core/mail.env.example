# ==============================================================================
# One Melody - Mail Worker Environment Configuration (.env.example)
# Service: Bun Nodemailer Background Consumer
# ==============================================================================

# Redis Connection (Upstash / Redis 7)
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL_ENABLED=true

# Queue Configuration
MAIL_QUEUE=mail_queue
QUEUE_EMPTY_DELAY_MS=2000
QUEUE_POLL_TIMEOUT_SECS=2

# SMTP Email Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="One Melody Springboot"
