# ==============================================================================
# One Melody - Mail Worker Environment Configuration (.env.example)
# Service: Bun Nodemailer Background Consumer
# ==============================================================================

# Redis Connection (Upstash / Redis 7)
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL_ENABLED=true

# Queue Configuration
MAIL_QUEUE=mail_queue
# Retries are held in <MAIL_QUEUE>_delayed (sorted set); failures land in <MAIL_QUEUE>_dlq (no OTPs stored).
# Longest BLPOP wait while idle (30-300 s); cut short when a retry is due.
QUEUE_BLOCK_TIMEOUT_SECS=55

# ------------------------------------------------------------------------------
# Mail provider: smtp (default, Gmail via nodemailer) | ses | resend
# ------------------------------------------------------------------------------
MAIL_PROVIDER=smtp
# Optional From header for every provider, e.g. "One Melody" <noreply@example.com>.
# smtp falls back to SMTP_FROM + SMTP_USER; ses/resend require an address on a verified domain.
# MAIL_FROM=

# --- smtp (MAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="One Melody Springboot"

# --- ses (MAIL_PROVIDER=ses) - AWS SDK v3 SESv2 SendEmail ---
# Uses the standard AWS credential chain; these are the same names the other services use.
# AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=ap-south-1
# SES_REGION=            # optional, overrides AWS_REGION for SES only
# SES_CONFIGURATION_SET= # optional

# --- resend (MAIL_PROVIDER=resend) - https://resend.com HTTP API ---
# RESEND_API_KEY=re_your_resend_api_key

# OpenTelemetry metrics (mail.sent / mail.send_failures / mail.dlq_pushed / mail.queue_length)
# Both are optional: these defaults reach the otel-collector on the compose network.
OTEL_SERVICE_NAME=mail-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
