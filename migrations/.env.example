# Database connection (PostgreSQL / Neon)
DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Algolia Configuration
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_INDEX_NAME=one_melody_springboot

# Recombee Configuration
RECOMBEE_DATABASE_ID=your_recombee_database_id
RECOMBEE_DATABASE_SECRET=your_recombee_database_secret
RECOMBEE_DATABASE_REGION=eu-west

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_TEMP_BUCKET=audiomelodyspringboottemp
S3_PRODUCTION_BUCKET=audiomelodyspringboot

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

