# API Base URL (Core Spring Boot backend)
NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_API_URL=http://localhost:9090

# CloudFront or S3 CDN URL for audio streaming and assets
NEXT_PUBLIC_S3_BASE_URL=https://your-cloudfront-id.cloudfront.net
# NEXT_PUBLIC_S3_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com
