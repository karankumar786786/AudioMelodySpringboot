# Redis config
REDIS_URL=
# OR use individual Redis settings instead of REDIS_URL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Main app webhook endpoints used by delete worker
APPLICATION_URL=http://localhost:9090/webhook/job
APPLICATION_DELETE_URL=http://localhost:9090/webhook/delete
APPLICATION_API_KEY=

# AWS S3 config used for file deletion
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket used by deleteS3.ts fallback
PRODUCTION_BUCKET_NAME=audioprocessingproduction

# Redis queue name for delete events
DELETE_EVENT_QUEUE=delete_event_queue
